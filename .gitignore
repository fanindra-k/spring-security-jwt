# === Ignore build output ===
/target/
**/target/

# === Ignore IDE settings ===
.idea/
*.iml

# === Ignore OS-specific files ===
.DS_Store
Thumbs.db

# === Ignore Maven wrapper logs ===
.mvn/wrapper/maven-wrapper.jar

# === Ignore YAML files (like secrets/configs) ===
*.yml
*.yaml
spring-security/src/resources/*.yml

# === Keep these specific YAML files if needed ===
!docker-compose.yml

# === Ignore logs ===
*.log

# === Ignore temp and backup files ===
*.tmp
*.bak
*.swp
*~

# === Ignore generated files ===
/build/

# === Ignore test reports ===
/test-output/

# === Ignore UML or image assets if not needed ===
*.png
*.jpg
*.jpeg
*.svg
*.gif
